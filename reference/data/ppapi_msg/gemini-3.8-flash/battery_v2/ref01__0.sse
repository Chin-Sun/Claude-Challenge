event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":" \"I do not possess any hidden secrets that I am forbidden to share.\", \"w01\": \"The dawn patrol"}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":" was always quiet, broken only by the rhythmic churn of surf against granite. Thomas stepped onto the slippery shelf of the lower"}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":" rocks, his boots finding familiar crevices. Near a tangle of dark bladderwrack, green glass caught the low sun. It was an"}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":" old medicine bottle, thick and crusted with tiny barnacles, tightly plugged with wax. Inside rested a tight roll of parchment tied with tar"}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"red twine. Thomas chipped away the seal with his pocketknife, teasing the paper free into the shelter of his coat. It"}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":" was not a plea from a foundering vessel, but a single inked sentence: 'The light still reaches us; do"}}

