data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":" wet gravel. Near the tide line, half-buried in cold foam, rested a heavy green bottle sealed with dark wax"}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":". Inside, a rolled parchment pressed against the glass. Arthur wiped away the brine with his sleeve, carefully prying the"}}

