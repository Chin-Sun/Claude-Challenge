data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"01\": \"Salt spray lashed the lantern room as Thomas descended the iron spiral stairs into the dawn mist. On the"}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":" rocky shore, where the high tide retreated over glistening kelp, something caught the morning sun. It was an amber bottle"}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":", sealed thick with pitch and half-buried in cold sand. Wiping away the brine, Thomas peeled back the w"}}

