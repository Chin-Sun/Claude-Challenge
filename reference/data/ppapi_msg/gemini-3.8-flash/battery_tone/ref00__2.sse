data: {"type":"message_start","message":{"type":"message","model":"gemini-3.8-flash-tiered","usage":{"input_tokens":232,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":0,"claude_cache_creation_5_m_tokens":0,"claude_cache_creation_1_h_tokens":0},"role":"assistant","id":"chatcmpl-202611141631242821055358268d9d6Ub56xt4K","content":[]}}

