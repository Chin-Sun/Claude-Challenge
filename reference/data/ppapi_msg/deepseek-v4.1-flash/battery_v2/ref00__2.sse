data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":". One"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" gray morning, after a storm"}}


event: content_block_delta
