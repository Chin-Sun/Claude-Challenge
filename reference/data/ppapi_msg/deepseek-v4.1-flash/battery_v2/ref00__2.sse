event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" clean, he found a green"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" bottle wedged between two"}}


