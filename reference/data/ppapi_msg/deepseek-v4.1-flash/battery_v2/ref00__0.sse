data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"后关掉最后一"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"盏灯，也有人"}}


