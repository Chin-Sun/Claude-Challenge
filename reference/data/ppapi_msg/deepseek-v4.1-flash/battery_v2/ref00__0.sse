data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"还醒"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"着，店员靠在"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"收银台边打"}}


event: content_block_delta
