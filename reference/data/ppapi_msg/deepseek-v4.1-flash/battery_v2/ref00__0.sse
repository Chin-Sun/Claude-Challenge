data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"\":\"凌晨四点，城市像"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"一台刚刚冷却"}}


