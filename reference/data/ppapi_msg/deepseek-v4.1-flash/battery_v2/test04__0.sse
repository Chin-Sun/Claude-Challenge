data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" gray"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" morning, after a storm"}}


event: content_block_delta
