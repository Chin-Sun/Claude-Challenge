data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" home.” There"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" was no name, only a"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" date from forty years earlier."}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" He read it twice, then"}}


