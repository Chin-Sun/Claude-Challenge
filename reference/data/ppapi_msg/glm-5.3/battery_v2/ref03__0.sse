event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"凌晨四点，城市"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"褪去了白日的喧嚣"}}


