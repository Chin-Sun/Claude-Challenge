data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" years and found nothing but"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" rope and plastic. Today"}}


