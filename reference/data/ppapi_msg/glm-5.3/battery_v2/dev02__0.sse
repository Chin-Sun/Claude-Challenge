data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" found a whole human heart"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":".\", \"w02\":"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" \"凌晨四点，"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"城市像一个尚未醒来的"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"巨人。街灯把"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"空旷的马路染"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"成昏黄，偶尔"}}


event: content_block_delta
