data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" at Cape Vela —"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" I watched your beam every"}}


