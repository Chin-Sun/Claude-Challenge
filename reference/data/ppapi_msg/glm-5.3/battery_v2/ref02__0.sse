data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" home when nothing else did"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":". Thank you.' No"}}


