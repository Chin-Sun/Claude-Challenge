data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"谁在天上慢慢抖"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"开一张灰色的帘"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"子。\n\n街上没什么人"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"。路灯的光落在积水"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"里，被雨点"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"砸得碎成一层"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"一层的金。偶尔"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"有车驶过，"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"声音很快又被雨声"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"盖了回去。\n\n我"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"坐在窗边听了一会儿"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"。雨不大不小，"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"正是让人想起旧事的"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"节奏。玻璃上的水"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"往下爬，爬到"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"一半忽然停住，"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"汇进另一条更"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"宽的路里去。\n\n"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"夜深了，雨"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"还没有要停的意思。\n\n"}}


