data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"了杯热茶坐在"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"窗边，听雨"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"点敲打遮雨"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"棚，密一阵，"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"疏一阵，像有人"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"絮絮低语。"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"楼下便利店的灯还"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"亮着，一个撑"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"伞的人快步跑"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"进去，在门口抖"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"落一身湿意。"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"这样的夜晚，时间仿佛"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"也被雨水泡软了"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"，走得格外慢。\n\n"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"## 5\n\nSubject"}}


event: content_block_delta
