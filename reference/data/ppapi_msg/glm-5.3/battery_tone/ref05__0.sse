data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" much for the invite —"}}


event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" I'd genuinely love to"}}


