data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "ith sink away and strange new ones rise. No phot"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "ograph needed. The sea itself tells you the shap"}}

