data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "e of the world, and the sea has never lied to me"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": ".\n\n## 3\n\nGood question — it took clever people a"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": " long while to work this one out, and it comes d"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "own to what sunlight does in the air. Sunlight l"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "ooks white, but it's really every color mixed to"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "gether, and each color travels as a wave. Blue t"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "ravels in short, tight waves; red in long, lazy "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "swells. The air is full of tiny particles too sm"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "all to see, and when light bumps into them, the "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "short waves scatter hard in every direction whil"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "e the long ones mostly slip on through. So blue "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "gets bounced all over the sky and comes at you f"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "rom every direction — that's why the whole dome "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "of it looks blue. At sunset, the light has to pl"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "ow through a lot more air before it reaches you,"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": " and by then the blue's been scattered away enti"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "rely. What's left is the reds and oranges. A sun"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "set is just the leftover colors — and now you kn"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "ow what you're looking at.\n\n## 4\n\n夜雨来得无声。先是檐角滴答，"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "随后雨脚渐密，把整条街的灯火敲得支离破碎。雨落在瓦上、叶上、积水里，各有各的声音，叠在一处，反而"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "衬得夜更静了。远处偶尔一道闪电，把云层照成灰白，雷声隔了很久才滚过来，闷闷的，像是从海底深处传上"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "来的。屋里一盏灯，热茶在手边冒着白气。这样的时候，人自然就慢了下来，坐着听雨，什么都不必想，什么"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "都不必说。\n\n## 5\n\nSubject: Friday drinks\n\nHi [Name],\n"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "\nThanks for the invite — glad to be asked. I'll "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "have to sit this one out, though; I keep my Frid"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "ay evenings quiet these days. Have a round for m"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "e, and count me in for the next one.\n\nFair winds"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": ",\n[Your name]\n\n## 6\n\nI write the way I've always"}}

