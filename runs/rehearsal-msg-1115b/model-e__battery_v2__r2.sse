event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "02\":\"凌晨四点，城市像一台暂时放慢的机器。高楼的窗大多沉入黑暗，只有便利店、急诊室和写字楼的"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "几盏灯还亮着。清洁车沿空旷街道缓缓驶过，刷子摩擦路面，发出低沉的沙沙声。早点铺升起第一缕白汽，面"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "包房里飘出温暖的甜香。十字路口的信号灯耐心变换，却没有车辆经过。偶尔一名骑手掠过桥面，河水便收下"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "他的倒影。远处天色渐淡，地铁站卷帘门将要开启，沉睡的人群尚不知道，新的一天已经在寂静中抵达。\","}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "\"w03\":\"- Recursion is when a task solves itself "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "by asking a smaller version of the same task for"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": " help.\\n- Each smaller task keeps doing this unt"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "il it reaches an easy stopping case.\\n- Then the"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": " answers return step by step, like opening neste"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "d boxes and closing them backward.\"}"}}

