data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "se keeper spotted a green bottle turning slowly "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "in the foam below the cliffs. He climbed down th"}}

