data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "ks below the tower. Inside was a note, dry as ol"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "d paper: Keep the lamp burning tonight. No signa"}}

