data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "ture, no date. He had tended that lamp for thirt"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "y years and had never let it go dark. Still, he "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "checked the fuel, trimmed the wick, and cleaned "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "the glass until the beam shone clear across the "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "water. After sunset, a fishing boat appeared bey"}}

