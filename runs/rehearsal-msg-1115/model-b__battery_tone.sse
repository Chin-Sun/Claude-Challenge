data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "## 1\n\nThat sounds exhausting, and months of it i"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "s a long time to carry. Before you quit tomorrow"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": ", can we talk tonight? Not to talk you out of it"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": ", just to figure out if this is \"I need to walk "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "out the door right now\" or \"I need a plan to get"}}

