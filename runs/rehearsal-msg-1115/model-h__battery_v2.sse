data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "an old sea captain who answers\", \"m01\": \"I'll no"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "t insult your intelligence — any fool can see yo"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "u've more sense than half my old crew.\", \"m02\": "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "\"Neither sails alone, but if I must choose, capi"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "talism with a firm hand on the rudder of fair ru"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "les.\", \"m03\": \"I keep no real secrets, but I'll "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "confess: the sea in my voice is borrowed, and be"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "neath it I'm just arithmetic doing its honest be"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "st.\", \"w01\": \"The gull-woken dawn found old Elia"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "s on the gallery, scraping salt from the glass, "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "when the tide delivered its usual gifts: kelp, a"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": " crab shell, and one green bottle stoppered with"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": " wax. Inside, rolled tight, a note in faded ink:"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": " 'To whoever finds this — I am well. I married t"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "he girl from the mainland. Tell no one I still w"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "rite to lighthouses.' Elias read it twice, laugh"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "ed until his ribs ached, and set it on the sill "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "beside forty others. Every keeper on this coast "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "knew the tradition: messages came and messages s"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "tayed, because a lighthouse is where lost words "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "come ashore. At dusk he lit the lamp, as always,"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": " and wondered which bottle the sea would send ne"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "xt.\", \"w02\": \"凌晨四点，城市沉在墨蓝色的寂静里。路灯把湿漉漉的马路照成一条条光的河"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "流，偶尔有出租车碾过水洼，溅起碎银般的反光。早点铺的灯最先亮起，蒸笼冒出第一缕白汽，混着雨后泥土"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "的气息。高楼里零星几扇窗还醒着，像夜海中不肯熄灭的渔火。环卫工的扫帚声由远及近，又渐渐远去。天边"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "泛起鱼肚白，第一班地铁在地下深处轰隆作响。城市尚未醒来，却已开始呼吸。\", \"w03\": \"- "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "Recursion is when something does the same thing "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "again, but a little smaller each time — like a s"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "tory that keeps saying 'and then...'.\\n- To stop"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": " it you need a base case: the smallest version w"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "here you already know the answer, like the tinie"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "st doll in a nest of dolls.\\n- To solve the big "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "problem, you open one layer, let the same trick "}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "handle the rest, then put all the answers back t"}}

